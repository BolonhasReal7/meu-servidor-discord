{
  "name": "transmissao-p2p-kaneki",
  "version": "1.0.0",
  "description": "Aplicativo de transmissão P2P",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.kaneki.p2p",
    "productName": "Transmissao P2P Kaneki",
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "mongoose": "^8.24.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
